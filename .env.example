# Copier en .env à la racine, ou exporter dans le shell.
DATABASE_URL=postgres://nudge:nudge@localhost:5432/nudge
REDIS_URL=redis://localhost:6379
NUDGE_API_PORT=3000
# Cookie de session du dashboard réservé à HTTPS (défaut : true). Ce fichier sert au
# développement local en HTTP : ne jamais mettre `false` sur une Instance exposée.
NUDGE_COOKIE_SECURE=false
# Clé d'Instance (32 octets en base64) qui chiffre les secrets stockés en base (clé du
# Juge, jetons des Destinations). Jamais en base ; la perdre rend ces secrets illisibles.
# Générer : openssl rand -base64 32
NUDGE_ENCRYPTION_KEY=
# Juge par défaut, quand aucun n'est choisi dans le dashboard (Paramètres) ; vide : mode
# dégradé. NUDGE_JUDGE_PROVIDER : typesafe | openrouter | auto_heberge.
NUDGE_JUDGE_PROVIDER=
NUDGE_JUDGE_API_KEY=
NUDGE_JUDGE_MODEL=
# Requise pour auto_heberge (tout serveur de l'API Decisions, ex. http://127.0.0.1:8080).
NUDGE_JUDGE_BASE_URL=
