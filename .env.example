# Copier en .env à la racine, ou exporter dans le shell.
DATABASE_URL=postgres://nudge:nudge@localhost:5432/nudge
REDIS_URL=redis://localhost:6379
NUDGE_API_PORT=3000
# Cookie de session du dashboard réservé à HTTPS (défaut : true). `false` pour un dashboard en HTTP local.
NUDGE_COOKIE_SECURE=false
