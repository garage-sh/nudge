# Configuration of a nudge Instance. Copy to `.env` at the root: `docker compose`
# reads it on its own. An empty variable takes its default value. An invalid value
# prevents the server from starting, with a message that names the variable.

# --- Required -------------------------------------------------------------------------

# Instance key (32 bytes in base64) that encrypts the secrets stored in the database
# (Judge key, Destination tokens, HMAC secrets). Never stored in the database; losing it
# makes these secrets unreadable (they must then be entered again).
# Generate: openssl rand -base64 32
NUDGE_ENCRYPTION_KEY=
# Postgres password (docker compose only). It goes into a URL: stick to letters and
# digits. Generate: openssl rand -hex 24
NUDGE_POSTGRES_PASSWORD=

# --- Version and roles ----------------------------------------------------------------

# Image version (docker compose; default: latest). Pinning a minor version (0.1)
# receives fixes without behaviour changes; an exact version (0.1.2) never moves. Read
# the release notes before changing minor version.
NUDGE_VERSION=
# What the nudge process runs: api, worker, or api,worker (default, a single process).
# docker-compose.worker.yml splits them to replicate the worker on its own.
NUDGE_ROLES=

# --- Access ---------------------------------------------------------------------------

# Published port of the dashboard, which also serves the api and the Widget
# (docker compose; 8080).
NUDGE_PORT=
# Public URL of the dashboard (https://nudge.example.com): "view the Feedback" links in
# Destinations and alerts. Empty: no link.
NUDGE_DASHBOARD_URL=
# Session cookie restricted to HTTPS (default: true). `false` only to try the Instance
# over HTTP elsewhere than on localhost; never on an exposed Instance.
NUDGE_COOKIE_SECURE=
# Proxies to traverse to read the client IP from X-Forwarded-For (Widget rate limit,
# sign-in brute-force protection). docker compose: 1 (the dashboard) by default; 2 with
# a TLS reverse proxy in front. Also accepts true, false or addresses (10.0.0.0/8).
# Outside docker compose, with the api exposed directly: leave empty (no proxy).
NUDGE_TRUST_PROXY=
# Rate limit of public-key (Widget) ingestion, in Feedbacks per minute: per IP
# (default 20) and per Project (default 600). Counted per api replica.
NUDGE_WIDGET_RATE_LIMIT_IP=
NUDGE_WIDGET_RATE_LIMIT_PROJECT=

# --- Judge ----------------------------------------------------------------------------

# Default Judge, when none is chosen in the dashboard (Settings); empty: degraded mode
# (no Severity, no Junk, no Manipulation; Uncertain Verdict).
# NUDGE_JUDGE_PROVIDER: typesafe | openrouter | self_hosted.
NUDGE_JUDGE_PROVIDER=
# Required for typesafe and openrouter, optional for self_hosted.
NUDGE_JUDGE_API_KEY=
# Model; empty: the provider's default (typesafe: jev-latest, openrouter:
# perplexity/pplx-decider-v1.2, self_hosted: pplx-decider-flash-v1.2).
NUDGE_JUDGE_MODEL=
# Required for self_hosted (any Decisions API server, e.g. http://decider:8080).
NUDGE_JUDGE_BASE_URL=
# Timeout in ms of a request to the Judge before giving up; the Triage is retried
# (default 30000).
NUDGE_JUDGE_TIMEOUT_MS=

# --- Triage ---------------------------------------------------------------------------

# Thresholds of the Verdict policy, between 0 and 1, reached as soon as they are equalled:
# probability of Junk (default 0.8), of Manipulation (default 0.7), and Judge confidence
# below which the Verdict is Uncertain (default 0.6).
NUDGE_TRIAGE_JUNK_THRESHOLD=
NUDGE_TRIAGE_MANIPULATION_THRESHOLD=
NUDGE_TRIAGE_CONFIDENCE_THRESHOLD=

# --- Dispatch and maintenance ---------------------------------------------------------

# Suspension of a Destination: consecutive transient failures (default 5), delay in ms
# before probing it (default 300000), probe period in ms (default 60000).
NUDGE_SUSPENSION_FAILURE_THRESHOLD=
NUDGE_SUSPENSION_COOLDOWN_MS=
NUDGE_SUSPENSION_PROBE_INTERVAL_MS=
# Period in ms of the Retention purge (default 3600000). The Retention period itself is
# set in the dashboard (Settings).
NUDGE_PURGE_INTERVAL_MS=

# --- Captures -------------------------------------------------------------------------

# Capture storage, the same for the api and the worker: disk (default) | s3.
NUDGE_CAPTURES_STORAGE=
# disk: an absolute path, shared by the api and the worker (default:
# /var/lib/nudge/captures). docker compose mounts the `captures` volume there and
# enforces it.
NUDGE_CAPTURES_DIR=
# s3 (S3-compatible: AWS, MinIO, Garage…): ENDPOINT, BUCKET, ACCESS_KEY_ID and
# SECRET_ACCESS_KEY are required; REGION (default us-east-1), PREFIX (default none),
# FORCE_PATH_STYLE (default true; false: bucket as a subdomain, as AWS prefers).
NUDGE_S3_ENDPOINT=
NUDGE_S3_REGION=
NUDGE_S3_BUCKET=
NUDGE_S3_ACCESS_KEY_ID=
NUDGE_S3_SECRET_ACCESS_KEY=
NUDGE_S3_PREFIX=
NUDGE_S3_FORCE_PATH_STYLE=

# --- Outside docker compose (apps run on the host, see the README) --------------------

# docker compose sets these itself and ignores the ones below.
# DATABASE_URL=postgres://nudge:nudge@localhost:5432/nudge
# REDIS_URL=redis://localhost:6379
# Listening port of the api (default 3000).
# NUDGE_API_PORT=3000
