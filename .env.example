# Configuration d'une Instance nudge. Copier en `.env` à la racine : `docker compose`
# le lit tout seul. Une variable vide prend sa valeur par défaut. Une valeur invalide
# empêche l'api ou le worker de démarrer, avec un message qui nomme la variable.

# --- Requises -------------------------------------------------------------------------

# Clé d'Instance (32 octets en base64) qui chiffre les secrets stockés en base (clé du
# Juge, jetons des Destinations, secrets HMAC). Jamais en base ; la perdre rend ces
# secrets illisibles (il faut alors les ressaisir). Générer : openssl rand -base64 32
NUDGE_ENCRYPTION_KEY=
# Mot de passe de Postgres (docker compose seulement). Il entre dans une URL : s'en tenir
# à des lettres et des chiffres. Générer : openssl rand -hex 24
NUDGE_POSTGRES_PASSWORD=

# --- Accès ----------------------------------------------------------------------------

# Port publié du dashboard, qui sert aussi l'api et le Widget (docker compose ; 8080).
NUDGE_PORT=
# URL publique du dashboard (https://nudge.exemple.com) : liens « voir le Retour » dans
# les Destinations et les alertes. Vide : pas de lien.
NUDGE_DASHBOARD_URL=
# Cookie de session réservé à HTTPS (défaut : true). `false` seulement pour essayer
# l'Instance en HTTP ailleurs que sur localhost ; jamais sur une Instance exposée.
NUDGE_COOKIE_SECURE=
# Proxys à traverser pour lire l'IP du client dans X-Forwarded-For (rate limit du
# Widget, anti force brute). docker compose : 1 (le dashboard) par défaut ; 2 avec un
# reverse proxy TLS devant. Accepte aussi true, false ou des adresses (10.0.0.0/8).
# Hors docker compose, l'api exposée directement : laisser vide (aucun proxy).
NUDGE_TRUST_PROXY=
# Rate limit de l'ingestion par clé publique (Widget), en Retours par minute : par IP
# (défaut 20) et par Projet (défaut 600). Compté par réplique de l'api.
NUDGE_WIDGET_LIMITE_IP=
NUDGE_WIDGET_LIMITE_PROJET=

# --- Juge -----------------------------------------------------------------------------

# Juge par défaut, quand aucun n'est choisi dans le dashboard (Paramètres) ; vide : mode
# dégradé (pas de Gravité, ni d'Indésirable, ni de Manipulation ; Verdict Incertain).
# NUDGE_JUDGE_PROVIDER : typesafe | openrouter | auto_heberge.
NUDGE_JUDGE_PROVIDER=
# Requise pour typesafe et openrouter, facultative pour auto_heberge.
NUDGE_JUDGE_API_KEY=
# Modèle ; vide : celui du fournisseur (jev-latest, perplexity/pplx-decider-v1.2).
NUDGE_JUDGE_MODEL=
# Requise pour auto_heberge (tout serveur de l'API Decisions, ex. http://decider:8080).
NUDGE_JUDGE_BASE_URL=
# Délai d'une requête au Juge en ms avant abandon ; le Triage est retenté (défaut 30000).
NUDGE_JUDGE_TIMEOUT_MS=

# --- Triage ---------------------------------------------------------------------------

# Seuils de la politique de Verdict, entre 0 et 1, atteints dès qu'ils sont égalés :
# probabilité d'Indésirable (défaut 0.8), de Manipulation (défaut 0.7), et confiance du
# Juge en dessous de laquelle le Verdict est Incertain (défaut 0.6).
NUDGE_TRIAGE_SEUIL_INDESIRABLE=
NUDGE_TRIAGE_SEUIL_MANIPULATION=
NUDGE_TRIAGE_SEUIL_CONFIANCE=

# --- Dispatch et maintenance ------------------------------------------------------------

# Suspension d'une Destination : échecs transitoires consécutifs (défaut 5), délai en ms
# avant de la sonder (défaut 300000), période en ms de la sonde (défaut 60000).
NUDGE_SUSPENSION_SEUIL_ECHECS=
NUDGE_SUSPENSION_REFROIDISSEMENT_MS=
NUDGE_SUSPENSION_INTERVALLE_SONDE_MS=
# Période en ms de la purge de Rétention (défaut 3600000). La durée de Rétention se
# règle dans le dashboard (Paramètres).
NUDGE_PURGE_INTERVALLE_MS=

# --- Captures -------------------------------------------------------------------------

# Stockage des Captures, le même pour l'api et le worker : disque (défaut) | s3.
NUDGE_CAPTURES_STOCKAGE=
# disque : un chemin absolu, partagé par l'api et le worker (défaut :
# /var/lib/nudge/captures). docker compose y monte le volume `captures` et l'impose.
NUDGE_CAPTURES_DOSSIER=
# s3 (S3-compatible : AWS, MinIO, Garage…) : requises ENDPOINT, BUCKET, ACCESS_KEY_ID et
# SECRET_ACCESS_KEY ; REGION (défaut us-east-1), PREFIXE, STYLE_CHEMIN (défaut true ;
# false : bucket en sous-domaine, comme AWS le préfère).
NUDGE_S3_ENDPOINT=
NUDGE_S3_REGION=
NUDGE_S3_BUCKET=
NUDGE_S3_ACCESS_KEY_ID=
NUDGE_S3_SECRET_ACCESS_KEY=
NUDGE_S3_PREFIXE=
NUDGE_S3_STYLE_CHEMIN=

# --- Hors docker compose (apps lancées sur le poste, voir le README) --------------------

# docker compose les fixe lui-même et ignore celles-ci.
# DATABASE_URL=postgres://nudge:nudge@localhost:5432/nudge
# REDIS_URL=redis://localhost:6379
# Port d'écoute de l'api (défaut 3000).
# NUDGE_API_PORT=3000
