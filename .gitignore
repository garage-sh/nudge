# Dependencies
node_modules

# Yarn Berry: only commit what must be committed.
# https://yarnpkg.com/getting-started/qa#which-files-should-be-gitignored
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Build outputs and caches
dist
build
coverage
.turbo
*.tsbuildinfo
.vite

# Local environments
.env
.env.*
!.env.example

# Local data (Captures on disk, dev volumes)
.data/

# Misc
.DS_Store
*.log
.idea
.vscode/*
!.vscode/extensions.json

# Playwright
test-results
playwright-report

# Claude Code (agent worktrees, local settings)
.claude/
