{
  "name": "nudge",
  "private": true,
  "description": "Collects, triages and dispatches user feedback from several projects. Open-source and self-hosted.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/garage-sh/nudge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garage-sh/nudge.git"
  },
  "bugs": "https://github.com/garage-sh/nudge/issues",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "dev": "yarn dev:infra && turbo run dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:reset": "docker compose -f docker-compose.dev.yml down -v && rm -rf .data/captures && yarn dev:infra && yarn db:migrate",
    "db:migrate": "yarn workspace @nudge/database db:migrate",
    "db:seed": "yarn workspace @nudge/database db:seed"
  },
  "devDependencies": {
    "@nudge/eslint-config": "workspace:*",
    "@swc/core": "^1.15.0",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "turbo": "^2.7.4",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
