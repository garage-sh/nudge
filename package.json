{
  "name": "nudge",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "dev": "yarn dev:infra && turbo run dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "yarn workspace @nudge/database db:migrate",
    "db:seed": "yarn workspace @nudge/database db:seed"
  },
  "devDependencies": {
    "@nudge/eslint-config": "workspace:*",
    "@swc/core": "^1.15.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "turbo": "^2.7.4",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.9",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
