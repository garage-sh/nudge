# The dashboard, the dashboard API (/api) and public ingestion (/v1) on a single
# origin: the session cookie stays first-party, without CORS. The variables
# NUDGE_API_UPSTREAM and NUDGE_DNS_RESOLVER are substituted when the container starts
# (official nginx image, /etc/nginx/templates).

# A name resolved on each request (cached at most 10 s) rather than once at startup.
resolver ${NUDGE_DNS_RESOLVER} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # The Widget sends a Capture in base64 (2 MiB of image, ~2.9 MB of body);
    # the api applies its own limits, stricter outside /v1/feedbacks.
    client_max_body_size 4m;

    set $nudge_api ${NUDGE_API_UPSTREAM};

    location ~ ^/(api|v1)/ {
        # No URI after the variable: the request goes to the api as is.
        proxy_pass $nudge_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The api reads the client IP here (Widget rate limit, brute-force protection):
        # NUDGE_TRUST_PROXY counts this proxy, and the ones in front of it. Appended,
        # not overwritten, so that a TLS proxy in front can pass the client IP on; the
        # compose file therefore keeps this port off the network (NUDGE_BIND), or a
        # client skipping that proxy would write its own entry.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The Widget for the script tag: <script src="https://<instance>/widget/nudge-widget.js">.
    location /widget/ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Vite's files, named by their content.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Single-page application: any other route serves index.html.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
    }
}
