# Le dashboard, l'API du dashboard (/api) et l'ingestion publique (/v1) sur une seule
# origine : le cookie de session reste first-party, sans CORS. Les variables
# NUDGE_API_UPSTREAM et NUDGE_DNS_RESOLVER sont substituées au démarrage du conteneur
# (image nginx officielle, /etc/nginx/templates).

# Un nom résolu à chaque requête (au plus 10 s de cache) plutôt qu'une fois au démarrage.
resolver ${NUDGE_DNS_RESOLVER} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Le Widget envoie une Capture en base64 (2 Mio d'image, ~2,9 Mo de corps) ;
    # l'api applique ses propres limites, plus strictes hors de /v1/retours.
    client_max_body_size 4m;

    set $nudge_api ${NUDGE_API_UPSTREAM};

    location ~ ^/(api|v1)/ {
        # Sans URI après la variable : la requête part telle quelle vers l'api.
        proxy_pass $nudge_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # L'api lit l'IP du client ici (rate limit du Widget, anti force brute) :
        # NUDGE_TRUST_PROXY compte ce proxy, et ceux placés devant lui.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Le Widget pour la balise script : <script src="https://<instance>/widget/nudge-widget.js">.
    location /widget/ {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Fichiers de Vite, nommés par leur contenu.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Application à page unique : toute autre route sert index.html.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
    }
}
