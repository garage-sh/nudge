{
  "name": "@nudge/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "The nudge server: public ingestion, dashboard API and, according to NUDGE_ROLES, the worker.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@nudge/source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --env-file-if-exists=../../.env --watch-path=dist dist/main.js",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nudge/core": "workspace:*",
    "@nudge/database": "workspace:*",
    "@nudge/destinations": "workspace:*",
    "@nudge/shared": "workspace:*",
    "@nudge/storage": "workspace:*",
    "@nudge/worker": "workspace:*",
    "bullmq": "^5.60.0",
    "cookie": "^1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "ioredis": "^5.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nudge/typescript-config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
