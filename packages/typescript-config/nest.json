{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // ES2022 would enable `define` semantics for class fields, which overwrite
    // the properties Nest injects.
    "useDefineForClassFields": false,
    "declaration": false
  }
}
