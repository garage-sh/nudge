{
  "name": "@nudge/database",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Schéma Drizzle, migrations et accès Postgres.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@nudge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "NODE_OPTIONS=--conditions=@nudge/source drizzle-kit generate",
    "db:migrate": "tsx --conditions=@nudge/source src/scripts/migrate.ts",
    "db:seed": "tsx --conditions=@nudge/source src/scripts/seed.ts"
  },
  "dependencies": {
    "@nudge/core": "workspace:*",
    "@nudge/shared": "workspace:*",
    "@types/pg": "^8.15.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@nudge/tsup-config": "workspace:*",
    "@nudge/typescript-config": "workspace:*",
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
