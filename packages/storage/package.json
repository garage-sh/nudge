{
  "name": "@nudge/storage",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Capture storage port and its adapters (local disk, S3-compatible).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@nudge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@nudge/tsup-config": "workspace:*",
    "@nudge/typescript-config": "workspace:*",
    "@types/node": "^24.10.0",
    "eslint": "^10.13.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
