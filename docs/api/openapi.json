{
  "openapi": "3.1.0",
  "info": {
    "title": "nudge public API",
    "version": "v1",
    "description": "Posts a Feedback, or reports an Incident, to a Project of a nudge Instance. The server URL is the Instance’s own."
  },
  "servers": [
    {
      "url": "https://nudge.example.com"
    }
  ],
  "paths": {
    "/v1/feedbacks": {
      "post": {
        "operationId": "postFeedback",
        "summary": "Post a Feedback",
        "description": "With the public key (`nk_pub_…`), the call must come from one of the Project’s Allowed origins and the Author is declared. With the secret key (`nk_sec_…`), from a server only, the Author is attested.",
        "security": [
          {
            "projectKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "text": {
                    "description": "The Author's words, not blank. Control characters are removed before the length is checked.",
                    "type": "string",
                    "maxLength": 5000
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "bug",
                      "suggestion",
                      "opinion",
                      "question"
                    ],
                    "description": "The type the Author chose: a hint, the Judge resolves the type of the Verdict."
                  },
                  "author": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "description": "The user's id in the application.",
                        "type": "string",
                        "maxLength": 255
                      },
                      "email": {
                        "description": "320 characters at most.",
                        "type": "string",
                        "format": "email",
                        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                      },
                      "name": {
                        "type": "string",
                        "maxLength": 255
                      }
                    },
                    "additionalProperties": false,
                    "description": "The signed-in user. Declared when sent with the public key, attested with the secret key."
                  },
                  "context": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "description": "The page the Feedback is about, 2048 characters at most.",
                        "type": "string",
                        "format": "uri"
                      },
                      "userAgent": {
                        "type": "string",
                        "maxLength": 1024
                      },
                      "viewport": {
                        "type": "object",
                        "properties": {
                          "width": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                          },
                          "height": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                          }
                        },
                        "required": [
                          "width",
                          "height"
                        ],
                        "additionalProperties": false,
                        "description": "Size of the browser window, in CSS pixels."
                      },
                      "metadata": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "additionalProperties": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 1000
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "description": "What the application knows and the Feedback does not say: plan, release, feature flag… 50 entries at most, with non-blank keys and scalar values only."
                      }
                    },
                    "additionalProperties": false
                  },
                  "capture": {
                    "type": "object",
                    "properties": {
                      "contentType": {
                        "type": "string",
                        "enum": [
                          "image/png",
                          "image/jpeg"
                        ]
                      },
                      "data": {
                        "type": "string",
                        "maxLength": 2796204,
                        "format": "base64",
                        "contentEncoding": "base64",
                        "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
                        "description": "The image, base64-encoded: 2097152 bytes at most once decoded, and its first bytes must match `contentType`."
                      }
                    },
                    "required": [
                      "contentType",
                      "data"
                    ],
                    "additionalProperties": false,
                    "description": "Screenshot of the page, masked and blurred before it leaves the browser."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "description": "Every object is strict: an unknown field refuses the whole Feedback."
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The Feedback is stored and awaits its Triage.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "state": {
                      "type": "string",
                      "const": "received"
                    }
                  },
                  "required": [
                    "id",
                    "state"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "invalid_feedback"
                      ]
                    },
                    "details": {
                      "type": "array",
                      "description": "The refused fields, for `invalid_feedback` and `invalid_incident`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "The key is missing or rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "missing_key",
                        "invalid_key"
                      ]
                    },
                    "details": {
                      "type": "array",
                      "description": "The refused fields, for `invalid_feedback` and `invalid_incident`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "The origin is not allowed for this Project.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "origin_refused"
                      ]
                    },
                    "details": {
                      "type": "array",
                      "description": "The refused fields, for `invalid_feedback` and `invalid_incident`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many Feedbacks (public key) or too many rejected secret keys (from this IP).",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "too_many_feedbacks",
                        "too_many_attempts"
                      ]
                    },
                    "details": {
                      "type": "array",
                      "description": "The refused fields, for `invalid_feedback` and `invalid_incident`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/incidents": {
      "post": {
        "operationId": "postIncident",
        "summary": "Report an Occurrence of an Incident",
        "description": "From a server only, with the Project’s secret key (`nk_sec_…`): the public key is refused. One request is one Occurrence. It opens an Incident, or is absorbed by the Open Incident of the Project with the same Fingerprint (declared, or derived from the title and the Environment). With `resolved: true`, it closes that Open Incident, and opens none.",
        "security": [
          {
            "projectKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "title": {
                    "description": "What is going wrong, not blank. Without a Fingerprint, Occurrences with the same title and Environment are grouped into one Incident.",
                    "type": "string",
                    "maxLength": 300
                  },
                  "message": {
                    "description": "The detail of what went wrong.",
                    "type": "string",
                    "maxLength": 5000
                  },
                  "level": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warning",
                      "error",
                      "critical"
                    ],
                    "description": "How serious it is. Without it, the Project’s default Level applies. A higher Level on a later Occurrence raises the Incident’s Level."
                  },
                  "environment": {
                    "description": "Where the application runs (production, staging…), as you name it.",
                    "type": "string",
                    "maxLength": 100
                  },
                  "fingerprint": {
                    "description": "Groups the Occurrences that share it into one Open Incident, whatever their titles (for a title carrying a variable id). Derived from the title and the Environment when absent.",
                    "type": "string",
                    "maxLength": 255
                  },
                  "context": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 1000
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "description": "What whoever reads the Incident needs to act: version, host, service, trace link… 50 entries at most, with non-blank keys and scalar values (strings of 1000 characters at most). It never decides the Fingerprint. Never put secrets or personal data in it."
                  },
                  "quietPeriod": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2592000,
                    "description": "Seconds the Incident stays Open without a new Occurrence before it closes on its own. Without it, the Project’s Quiet period applies. The last Occurrence’s value counts: send it on every Occurrence of a job that reports at its own rhythm."
                  },
                  "resolved": {
                    "type": "boolean",
                    "description": "The problem is over: the Occurrence closes the Open Incident it matches, and its Destinations are told. When no Open Incident matches, nothing is recorded."
                  }
                },
                "required": [
                  "title"
                ],
                "additionalProperties": false,
                "description": "One request is one Occurrence. Strict: an unknown field refuses the Occurrence."
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "The Occurrence is recorded in the Incident returned; `id` and `state` are `null` when a `resolved` Occurrence matched no Open Incident (nothing recorded).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid",
                      "description": "The Incident the Occurrence landed in."
                    },
                    "state": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "open",
                        "closed",
                        null
                      ]
                    },
                    "opened": {
                      "type": "boolean",
                      "description": "`true` when this Occurrence opened the Incident."
                    }
                  },
                  "required": [
                    "id",
                    "state",
                    "opened"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "invalid_incident"
                      ]
                    },
                    "details": {
                      "type": "array",
                      "description": "The refused fields, for `invalid_feedback` and `invalid_incident`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "The key is missing or rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "missing_key",
                        "invalid_key"
                      ]
                    },
                    "details": {
                      "type": "array",
                      "description": "The refused fields, for `invalid_feedback` and `invalid_incident`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "403": {
            "description": "A public key was sent: Incidents require the secret key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "secret_key_required"
                      ]
                    },
                    "details": {
                      "type": "array",
                      "description": "The refused fields, for `invalid_feedback` and `invalid_incident`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many rejected secret keys from this IP.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "too_many_attempts"
                      ]
                    },
                    "details": {
                      "type": "array",
                      "description": "The refused fields, for `invalid_feedback` and `invalid_incident`.",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "message"
                        ]
                      }
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "projectKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "The Project’s public key (Widget) or secret key (server)."
      }
    }
  }
}
